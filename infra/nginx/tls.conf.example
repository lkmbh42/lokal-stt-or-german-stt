# TLS variant of default.conf — internal CA or self-signed certificates.
#
# Setup:
#   1. ./tls/generate-self-signed.sh stt.example.internal   (or use certs
#      issued by your internal CA — any PEM cert/key pair works)
#   2. cp nginx/tls.conf.example nginx/default.conf
#   3. In docker-compose.yml, publish 443 and mount ./tls (see the
#      commented lines on the nginx service).
#   4. docker compose up -d nginx
#
# Self-signed note: clients must import tls/cert.pem (or your internal CA
# root) into their trust store, otherwise browsers warn on every visit.

map $http_upgrade $connection_upgrade {
    default upgrade;
    "" close;
}

upstream stt_api {
    server api:8000;
}

# HTTP: redirect everything to TLS
server {
    listen 80;
    server_name _;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name _;

    ssl_certificate     /etc/nginx/tls/cert.pem;
    ssl_certificate_key /etc/nginx/tls/key.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_session_cache   shared:SSL:10m;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "same-origin" always;
    # script-src/worker-src need blob: — the mic recorder loads its
    # AudioWorklet from a Blob URL (addModule fails with AbortError otherwise)
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' blob:; worker-src 'self' blob:; img-src 'self' data:; style-src 'self' 'unsafe-inline'" always;

    client_max_body_size 512m;

    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        proxy_pass http://stt_api;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;

        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}
