# Copy to .env and fill in. NEVER commit the real .env.

# --- Secrets (required) ------------------------------------------------
# openssl rand -hex 32
STT_SECRET_KEY=
POSTGRES_PASSWORD=

# --- Initial admin (created only if the users table is empty) ----------
STT_BOOTSTRAP_ADMIN_USERNAME=admin
STT_BOOTSTRAP_ADMIN_PASSWORD=

# --- Engine ------------------------------------------------------------
# Pre-staged CTranslate2 model directory inside the container (mounted
# read-only from ./models — stage with engine/scripts/download_model.py).
# large-v3 = maximum accuracy (needs a GPU for sensible throughput).
# CPU-only servers: use large-v3-turbo — near-equal German accuracy at
# roughly 4x the speed (stage with: download_model.py large-v3-turbo).
STT_ENGINE__MODEL=/models/faster-whisper-large-v3
STT_ENGINE__LOCAL_FILES_ONLY=true
# auto = CUDA when available (see worker `gpus` note in docker-compose.yml)
STT_ENGINE__DEVICE=auto

# --- Network -----------------------------------------------------------
# Host port nginx publishes
STT_HTTP_PORT=8080

# --- Capacity ----------------------------------------------------------
# GPU slots — must fit VRAM (large-v3 float16 ~4.7 GB per slot)
STT_MAX_CONCURRENT_JOBS=1
STT_MAX_UPLOAD_MB=500

# --- Tokens ------------------------------------------------------------
STT_ACCESS_TOKEN_MINUTES=15
STT_REFRESH_TOKEN_DAYS=7
